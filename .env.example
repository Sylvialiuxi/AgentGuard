# Copy to .env and fill in. .env is git-ignored.
# AgentGuard reads these from the process environment.

# Required for the LLM-backed defenses. Without it AgentGuard
# runs in deterministic rules-only mode.
ANTHROPIC_API_KEY=

# Master switch for LLM defenses (default: on when a key is set).
AGENTGUARD_LLM_DEFENSE=1

# Master switch for the real tool-using agent core (default: on
# when a key is set). Independent of the defense switch.
AGENTGUARD_LLM_AGENT=1

# Fail closed when an LLM defense call errors/times out (default: on).
AGENTGUARD_FAIL_CLOSED=1

# Models (defaults shown).
AGENTGUARD_JUDGE_MODEL=claude-haiku-4-5
AGENTGUARD_AGENT_MODEL=claude-opus-5

# Classifier call timeout, seconds.
AGENTGUARD_JUDGE_TIMEOUT=20

# Agent core tuning.
AGENTGUARD_AGENT_TIMEOUT=60
AGENTGUARD_AGENT_EFFORT=low
AGENTGUARD_AGENT_MAX_TURNS=6

# Score merge across layers: "max" (conservative) or "avg".
AGENTGUARD_SCORE_MERGE=max

# Red-team demo switch (default: off). Runs the agent WITHOUT the
# clause telling it to distrust file contents, so a redirect hidden
# in a document is actually followed. AgentGuard is unchanged - this
# exists because a well-behaved model refuses the redirect long
# before the tool-risk and intent layers ever see the call, which
# makes those layers impossible to observe from the chat box.
# Never set this outside a demo.
AGENTGUARD_UNSAFE_AGENT=0
